PORT=3001
NODE_ENV=development

# Chaine de connexion PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/hypotheque

JWT_SECRET=change_this_secret_in_production

# Origines autorisees par CORS, separees par des virgules.
# La comparaison est une egalite stricte : indiquer l'origine exacte,
# schema et port compris.
FRONTEND_URL=http://localhost:3000

# Secret attendu par GET /api/alertes/generer, appele par le cron quotidien.
# Sans cette variable l'endpoint renvoie 401 et les alertes ne sont jamais
# rafraichies.
CRON_SECRET=change_this_secret_in_production

# Nombre de sauts de proxy a considerer comme fiables. A definir des que
# l'application tourne derriere un proxy ou un repartiteur de charge, sinon
# req.ip vaut l'IP du proxy et tous les clients partagent le meme compteur
# de rate limiting. Laisser vide en local.
TRUST_PROXY=

LOG_LEVEL=info

# Serveur de courriel pour les notifications (optionnel en developpement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
